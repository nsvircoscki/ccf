generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Contador próprio por tipo de processo (Unificação, Retificação...), usado no
// nome do projeto do Kanban quando um orçamento é aprovado. Nunca reseta por
// ano, igual ao sequencial global do Servico.
model SequencialTipoServico {
  tipo  String @id
  valor Int    @default(0)
}

// Associação editável entre templates de documento (chave de TEMPLATES em
// documentoService.js) e os tipos de serviço aos quais eles se aplicam. Um
// template sem nenhuma linha aqui é considerado "geral" e aparece para
// qualquer tipo de serviço (ex.: Protocolo de Entrega, Dossiê).
model TemplateTipoServico {
  id            String @id @default(uuid())
  templateChave String
  tipoServico   String

  @@unique([templateChave, tipoServico])
}

// Cadastro de clientes, feito após a aprovação do orçamento (o Servico guarda
// só o nome do cliente até então). Ainda não há vínculo com Servico — isso
// fica para a tela de vinculação, que virá depois.
model Cliente {
  id          String   @id @default(uuid())
  tipo        String   // "Física" | "Jurídica"
  nome        String   // Nome completo (PF) ou Razão Social (PJ)
  documento   String?  @unique // CPF (PF) ou CNPJ (PJ) — opcional: nem sempre temos o documento de quem estamos cadastrando
  rg          String?  // Só PF
  orgaoEmissor String? // Órgão emissor do RG (ex.: SSP/SC) — só PF
  rgDataExpedicao DateTime?
  dataNascimento  DateTime?
  representanteLegalNome  String?
  representanteLegalCpf   String?
  representanteLegalCargo String?
  representanteLegalDataNascimento DateTime?
  telefone    String?
  email       String?
  logradouro  String?
  numero      String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?
  pastaLink   String?
  situacao    String?

  // Usados para montar a "qualificação completa" nos documentos gerados
  // (ex.: "João da Silva, brasileiro, casado, engenheiro, portador do CPF...").
  nacionalidade String?
  estadoCivil   String?
  profissao     String?

  // Cônjuge: outra Pessoa já cadastrada (só faz sentido se estadoCivil for
  // casado(a) ou em união estável). @unique em conjugeId garante que ninguém
  // seja cônjuge de duas pessoas ao mesmo tempo. O vínculo é gravado só do
  // lado editado (A aponta pra B); quem lê precisa checar os dois campos
  // (cliente.conjuge ?? cliente.conjugeDe) para achar o cônjuge de qualquer
  // um dos dois lados — ver resolverConjuge em clienteService.js.
  conjugeId   String?  @unique
  conjuge     Cliente? @relation("ConjugeCliente", fields: [conjugeId], references: [id])
  conjugeDe   Cliente? @relation("ConjugeCliente")

  // Um Imóvel pode ter mais de um proprietário (ex.: casal, herdeiros em
  // condomínio) e um Serviço pode ter mais de um cliente na ponta do
  // proprietário — por isso os dois viram N:M em vez de uma FK única.
  imoveis           Imovel[] @relation("ProprietarioImovel")
  imoveisUsufruto   Imovel[] @relation("UsufrutuarioImovel")
  servicos          Servico[] @relation("ProprietarioServico")
  servicosProcurador Servico[] @relation("ProcuradorServico")

  // Faturamento
  cobrancas         Cobranca[]
  notasFiscais      NotaFiscal[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// Cadastro de imóvel, sempre vinculado a um Cliente já cadastrado (o
// proprietário). Separado do Servico: o Servico guarda seus próprios dados de
// terreno/matrícula/área hoje, e a ligação Imovel<->Servico fica para a mesma
// tela de vinculação futura mencionada acima.
model Imovel {
  id             String   @id @default(uuid())
  cartorio       String?
  matricula      String?
  cns            String?
  incra          String?
  cib            String?
  logradouro     String?
  municipio      String?
  estado         String? // UF, separado do município
  area           Float?  // Área registrada do imóvel, em m²
  descricao      String?
  // "Matrícula" ou "Transcrição" — entra em minúsculo no meio da frase dos
  // documentos ("constante na matrícula 12.345").
  tipoTitulo     String?  @default("matrícula")
  comarca        String?
  zoneamento     String?

  // N:M: um imóvel pode ter mais de um proprietário (ver comentário em
  // Cliente.imoveis).
  proprietarios  Cliente[] @relation("ProprietarioImovel")

  // Usufruto: quando alguém tem direito de uso/gozo do imóvel sem ser o
  // proprietário (comum em heranças, e pode ser mais de uma pessoa — ex.:
  // ambos os cônjuges). O(s) usufrutuário(s) também precisam aparecer
  // qualificados nos documentos, por isso são Pessoas, não texto livre.
  usufruto        Boolean   @default(false)
  usufrutuarios   Cliente[] @relation("UsufrutuarioImovel")

  servicos       Servico[]
  confrontanteDeServicos Servico[] @relation("ConfrontantesServico")

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model CartorioCns {
  cns         String  @id
  cartorio    String?
  comarca     String?
  updated_at  DateTime @updatedAt
}

// Etapas padrão de cada tipo de processo (Retificação, Desmembramento...),
// usadas ao fabricar/editar um projeto no Kanban (ver fabricarProjeto e
// editarProjeto em workflowService.js). Editável pela tela de Configurações
// > Etapas, restrita ao usuário ENG — substituiu o antigo
// CATALOGO_PROCESSOS/MAPEAMENTO_SETORES fixo no código.
model TipoProcessoEtapa {
  id           String @id @default(uuid())
  tipoProcesso String
  nome         String
  setor        String
  ordem        Int

  @@unique([tipoProcesso, nome])
}

model Role {
  id    String @id @default(uuid())
  name  String @unique

  users User[]
  steps WorkflowStep[]
  notifications Notification[]
}

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  // Nulo = usuário ainda não criou a própria senha (força o fluxo de
  // "criar senha" no primeiro login, em vez de aceitar qualquer coisa).
  password_hash String?

  roleId        String
  role          Role   @relation(fields: [roleId], references: [id])

  history       TicketHistory[]
  comments      Comment[]
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  matricula   String?
  endereco    String?
  details     String?
  terreno     String?  @default("Urbano")

  servicoId   String?
  servico     Servico? @relation(fields: [servicoId], references: [id])

  created_at  DateTime @default(now())
  steps       WorkflowStep[]
  tickets     Ticket[]
  notifications Notification[]
}

model WorkflowStep {
  id             String   @id @default(uuid())
  step_name      String
  sequence_order Int      
  
  workflowId     String
  workflow       Workflow @relation(fields: [workflowId], references: [id])
  
  requiredRoleId String
  requiredRole   Role     @relation(fields: [requiredRoleId], references: [id])

  tickets        Ticket[]
  historyFrom    TicketHistory[] @relation("FromStep")
  historyTo      TicketHistory[] @relation("ToStep")
}

model Ticket {
  id            String   @id @default(uuid())
  title         String
  description   String?
  created_at    DateTime @default(now())
  sequence      Int      @default(0)

  workflowId    String
  workflow      Workflow @relation(fields: [workflowId], references: [id])

  currentStepId String
  currentStep   WorkflowStep @relation(fields: [currentStepId], references: [id])

  history       TicketHistory[]
  comments      Comment[]
  notifications Notification[]
}

model Notification {
  id         String   @id @default(uuid())
  mensagem   String
  lida       Boolean  @default(false)
  created_at DateTime @default(now())
  // Destino ao clicar: "kanban" (padrão, comportamento antigo) | "sis-ponto"
  // | "sis-ponto-justificativa" (abre direto a aba Justificativas do ENG).
  tipo       String   @default("kanban")

  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])

  ticketId   String?
  ticket     Ticket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  workflowId String?
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model TicketHistory {
  id               String   @id @default(uuid())
  action_timestamp DateTime @default(now())

  ticketId         String
  ticket           Ticket   @relation(fields: [ticketId], references: [id])

  userId           String
  user             User     @relation(fields: [userId], references: [id])

  fromStepId       String?  
  fromStep         WorkflowStep? @relation("FromStep", fields: [fromStepId], references: [id])

  toStepId         String
  toStep           WorkflowStep @relation("ToStep", fields: [toStepId], references: [id])
}

model Comment {
  id         String   @id @default(uuid())
  text       String
  created_at DateTime @default(now())

  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

model Servico {
  id            String   @id @default(uuid())
  sequencial    Int      @default(autoincrement())
  numeroServico String   @unique
  tipoCliente   String
  nomeCliente   String
  contato       String?

  matricula             String?
  terreno               String?  @default("Urbano")
  possuiCar             String?
  possuiCertificacao    String?
  confrontaCertificacao String?
  codRespTecnPossui     String?
  respTecnPossui        String?
  codRespTecn           String?
  respTecn              String?
  notas                 String?

  area          Float?
  municipio     String
  linhaSecaKm   Float?
  rioKm         Float?
  caminhoPasta  String?
  arquivoKml    String?

  tiposSolicitados  String[]

  statusOrcamento  String   @default("PENDENTE")
  contratoGerado   Boolean  @default(false)

  // --- Vinculação (proprietário/imóvel/confrontantes) e dados específicos
  // deste serviço para a geração de documentos (retificação, por ex.) ---
  // N:M: o mesmo serviço pode ter mais de um proprietário (ver comentário em
  // Cliente.imoveis) — todos entram na qualificação dos documentos gerados.
  proprietarios                Cliente[] @relation("ProprietarioServico")
  // Papel do(s) cliente(s) NESTE serviço (herdeiro, inventariante, representante,
  // proprietário) — contextual: a mesma pessoa pode ser "proprietário" num
  // serviço e "herdeiro" em outro, por isso não fica salvo no Cliente.
  situacaoProprietario         String?
  // Confrontantes deste serviço: outros Imóveis já cadastrados, escolhidos na
  // vinculação — o dono de cada um (imovel.proprietario) é quem entra na
  // qualificação dos documentos. Evita ter que recadastrar a pessoa; o mesmo
  // imóvel pode ser confrontante de vários serviços diferentes.
  confrontantes                Imovel[] @relation("ConfrontantesServico")
  imovelId                    String?
  imovel                      Imovel?  @relation(fields: [imovelId], references: [id])
  // Procurador: pessoa já cadastrada com procuração para representar o(s)
  // proprietário(s) neste serviço específico — opcional, e um só por serviço
  // (diferente de proprietarios/confrontantes, que são N:M).
  procuradorId                 String?
  procurador                   Cliente? @relation("ProcuradorServico", fields: [procuradorId], references: [id])
  descricaoAtualImovel        String?
  memorialDescritivoRetificacao String?
  superiorOuInferior          String?  // "superior" | "inferior"
  totalLotes                  Int?
  averbacoes                  String?
  areasDesmembramento         String?  // Req_PMSBS_DESM_Áreas
  listaProtocoloEntrega       String?

  // --- Orçamento ---
  valorReferencia    Float?
  valorTotal         Float?
  descontoValor      Float?
  descontoPercentual Float?
  valorFinal         Float?

  // --- Condições de pagamento ---
  entradaValor     Float?
  entradaData      DateTime?
  numeroParcelas   Int?
  jurosAtivo       Boolean  @default(false)
  taxaJuros        Float?
  tipoJuros        String?
  baseJuros        String?

  itensOrcamento   OrcamentoItem[]
  parcelas         ParcelaOrcamento[]
  workflows        Workflow[]

  // Faturamento
  cobrancas        Cobranca[]
  notasFiscais     NotaFiscal[]

  tarefas          Tarefa[]

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

// Uma linha por serviço da tela de Orçamento, com o índice que o usuário
// editou. Guardar o índice junto do valor preserva como o preço foi formado,
// mesmo que o valor de referência mude depois.
model OrcamentoItem {
  id          String  @id @default(uuid())
  nome        String
  indice      Float    @default(0)
  valor       Float    @default(0)
  selecionado Boolean  @default(false)

  servicoId   String
  servico     Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([servicoId, nome])
}

model ParcelaOrcamento {
  id         String    @id @default(uuid())
  numero     Int
  valorBase  Float     @default(0)
  juros      Float     @default(0)
  valorFinal Float     @default(0)
  vencimento DateTime?

  servicoId  String
  servico    Servico   @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([servicoId, numero])
}

// O boleto é sempre por parcela (a API do Inter emite um título por vez) —
// Cobranca é só o "guarda-chuva" com os dados do cliente e a descrição,
// compartilhados por todas as parcelas; cada ParcelaCobranca é emitida (e
// tem seu próprio status/PDF) individualmente.
model Cobranca {
  id         String   @id @default(uuid())
  servicoId  String?
  servico    Servico? @relation(fields: [servicoId], references: [id])
  clienteId  String?
  cliente    Cliente? @relation(fields: [clienteId], references: [id])

  // Snapshot do momento do lançamento
  nomeCliente        String
  documentoCliente   String
  logradouro         String?
  numero             String?
  bairro             String?
  cidade             String?
  estado             String?
  cep                String?
  telefone           String?
  email              String?

  descricao          String?
  instrucoes         String?

  parcelas           ParcelaCobranca[]

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model ParcelaCobranca {
  id                 String   @id @default(uuid())
  cobrancaId         String
  cobranca           Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)

  numero             Int
  valor              Float
  vencimento         DateTime

  status             String   @default("PENDENTE") // PENDENTE | EMITIDO | ERRO
  seuNumero          String?
  codigoSolicitacao  String?
  caminhoPdf         String?
  erroMensagem       String?

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([cobrancaId, numero])
}

model NotaFiscal {
 id                  String   @id @default(uuid()) 
 servicoId           String?
 servico             Servico? @relation(fields: [servicoId], references: [id])
 clienteId           String?
 cliente             Cliente? @relation(fields: [clienteId], references: [id])

 empresa             String
 nomeCliente         String
 documentoCliente    String
 logradouro          String?
 cep                 String?
 cidade              String?

 valor               Float
 descricao           String

 status              String @default("PENDENTE")
 numeroNfse          String?
 linkPrefeitura      String?
 caminhoPdf          String?
 erroMensagem        String?

 created_at          DateTime @default(now())
 updated_at          DateTime @updatedAt
}

model Tarefa {
  id          String    @id @default(uuid())
  titulo      String
  descricao   String?
  setor       String    // DES | TOPO | ENG | CRD — mesmo valor de usuarioLogado
  prioridade  String    @default("MEDIA") // BAIXA | MEDIA | ALTA

  servicoId   String?
  servico     Servico?  @relation(fields: [servicoId], references: [id])

  prazo       DateTime?
  observacoes String?
  linkPasta   String?   // caminho de rede/local da pasta do serviço (ex.: \\SERVIDOR\Pasta)

  status       String    @default("PENDENTE") // PENDENTE | CONCLUIDA
  criadoPor    String?   // setor de quem lançou (usuarioLogado no momento da criação)
  concluidoPor String?
  concluido_em DateTime?

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    String @id @default(uuid())
  name  String @unique 
  
  users User[]
  steps WorkflowStep[]
}

model User {
  id            String @id @default(uuid())
  name          String
  email         String @unique
  password_hash String
  
  roleId        String
  role          Role   @relation(fields: [roleId], references: [id])
  
  history       TicketHistory[]
  comments      Comment[]
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  matricula   String?
  endereco    String?
  details     String?
  terreno     String?  @default("Urbano")

  servicoId   String?
  servico     Servico? @relation(fields: [servicoId], references: [id])

  created_at  DateTime @default(now())
  steps       WorkflowStep[]
  tickets     Ticket[]
}

model WorkflowStep {
  id             String   @id @default(uuid())
  step_name      String
  sequence_order Int      
  
  workflowId     String
  workflow       Workflow @relation(fields: [workflowId], references: [id])
  
  requiredRoleId String
  requiredRole   Role     @relation(fields: [requiredRoleId], references: [id])

  tickets        Ticket[]
  historyFrom    TicketHistory[] @relation("FromStep")
  historyTo      TicketHistory[] @relation("ToStep")
}

model Ticket {
  id            String   @id @default(uuid())
  title         String
  description   String?
  created_at    DateTime @default(now())

  workflowId    String
  workflow      Workflow @relation(fields: [workflowId], references: [id])

  currentStepId String
  currentStep   WorkflowStep @relation(fields: [currentStepId], references: [id])

  history       TicketHistory[]
  comments      Comment[]
}

model TicketHistory {
  id               String   @id @default(uuid())
  action_timestamp DateTime @default(now())

  ticketId         String
  ticket           Ticket   @relation(fields: [ticketId], references: [id])

  userId           String
  user             User     @relation(fields: [userId], references: [id])

  fromStepId       String?  
  fromStep         WorkflowStep? @relation("FromStep", fields: [fromStepId], references: [id])

  toStepId         String
  toStep           WorkflowStep @relation("ToStep", fields: [toStepId], references: [id])
}

model Comment {
  id         String   @id @default(uuid())
  text       String
  created_at DateTime @default(now())

  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

model Servico {
  id            String   @id @default(uuid())
  numeroServico String   @unique
  tipoCliente   String
  nomeCliente   String
  contato       String?

  matricula             String?
  terreno               String?  @default("Urbano")
  possuiCar             String?
  possuiCertificacao    String?
  confrontaCertificacao String?
  codRespTecn           String?
  respTecn              String?
  notas                 String?

  area          Float?
  municipio     String
  linhaSecaKm   Float?
  rioKm         Float?
  caminhoPasta  String?
  arquivoKml    String?

  tiposSolicitados  String[]

  statusOrcamento  String   @default("PENDENTE")
  valorTotal       Float?
  contratoGerado   Boolean  @default(false)

  workflows        Workflow[]

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}



